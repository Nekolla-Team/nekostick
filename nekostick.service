[Unit]
Description=Nekostick Host
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=nekostick
Group=nekostick
WorkingDirectory=/opt/nekostick
EnvironmentFile=/etc/nekostick/nekostick.env
ExecStart=/opt/nekostick/Nekolla.Nekostick.Host run
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
KillMode=control-group
TimeoutStopSec=45s
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
# The Host extracts its embedded helper into the nekostick user's cache.
ProtectHome=false
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
